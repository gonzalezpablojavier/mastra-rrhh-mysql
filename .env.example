# ───────────────────────────────────────────────────────────────
# Proveedor del modelo (elige uno)
# ───────────────────────────────────────────────────────────────
# OpenAI directo:
OPENAI_API_KEY=

# OpenRouter (si se define, tiene prioridad sobre OPENAI_API_KEY):
OPENROUTER_API_KEY=

# Modelo a usar (opcional). Formato del model router de Mastra: "<provider>/<model>".
# Ej: openai/gpt-4o-mini  (por defecto)
AGENT_MODEL_ID=

# ───────────────────────────────────────────────────────────────
# Base de datos MySQL de RRHH
# ───────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_DATABASE=roma_rrhh

# ───────────────────────────────────────────────────────────────
# Almacenamiento de Mastra (memoria, trazas, vector store RAG).
# Local: SQLite en archivo. En SERVERLESS (Vercel) el filesystem no persiste:
# usar Turso (libsql remoto) -> LIBSQL_URL=libsql://tu-base.turso.io + token.
# ───────────────────────────────────────────────────────────────
LIBSQL_URL=file:./mastra.db
LIBSQL_AUTH_TOKEN=

# ───────────────────────────────────────────────────────────────
# Logging
# ───────────────────────────────────────────────────────────────
LOG_LEVEL=info
